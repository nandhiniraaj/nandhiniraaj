<svg
  width="1000"
  height="190"
  viewBox="0 0 1000 190"
  xmlns="http://www.w3.org/2000/svg">

  <!-- ========================================= -->
  <!-- JERSEY 25 FONT                            -->
  <!-- ========================================= -->

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Jersey+25&amp;display=swap');

    .jersey-25-regular {
      font-family: "Jersey 25", sans-serif;
      font-weight: 400;
      font-style: normal;
    }
  </style>


  <!-- ========================================= -->
  <!-- FILTERS                                   -->
  <!-- ========================================= -->

  <defs>

    <!-- Neon purple glow -->
    <filter
      id="purpleGlow"
      x="-50%"
      y="-50%"
      width="200%"
      height="200%">

      <feGaussianBlur
        stdDeviation="3"
        result="blur"/>

      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>

    </filter>


    <!-- Neon pink glow -->
    <filter
      id="pinkGlow"
      x="-50%"
      y="-50%"
      width="200%"
      height="200%">

      <feGaussianBlur
        stdDeviation="3"
        result="blur"/>

      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>

    </filter>


    <!-- ======================================= -->
    <!-- RGB SPLIT                               -->
    <!-- ======================================= -->

    <filter
      id="rgb-split"
      x="-20%"
      y="-30%"
      width="140%"
      height="160%">

      <!-- RED CHANNEL -->

      <feOffset
        in="SourceGraphic"
        dx="4"
        dy="0"
        result="layer-one"/>

      <feComponentTransfer
        in="layer-one"
        result="red">

        <feFuncR
          type="identity"/>

        <feFuncG
          type="discrete"
          tableValues="0"/>

        <feFuncB
          type="discrete"
          tableValues="0"/>

      </feComponentTransfer>


      <!-- CYAN CHANNEL -->

      <feOffset
        in="SourceGraphic"
        dx="-4"
        dy="0"
        result="layer-two"/>

      <feComponentTransfer
        in="layer-two"
        result="cyan">

        <feFuncR
          type="discrete"
          tableValues="0"/>

        <feFuncG
          type="identity"/>

        <feFuncB
          type="identity"/>

      </feComponentTransfer>


      <!-- COMBINE -->

      <feBlend
        in="red"
        in2="cyan"
        mode="screen"
        result="color-split"/>

    </filter>

  </defs>


  <!-- ========================================= -->
  <!-- MAIN HEADING — NORMAL                    -->
  <!-- ========================================= -->

  <text
    class="jersey-25-regular"
    x="500"
    y="58"
    text-anchor="middle"
    font-size="43"
    fill="#d88cff"
    filter="url(#purpleGlow)">

    Hey, I'm Nandhini

    <!-- briefly dim during glitch -->
    <animate
      attributeName="opacity"
      values="1;1;0.12;1;1"
      keyTimes="0;0.35;0.38;0.42;1"
      dur="4s"
      repeatCount="indefinite"/>

  </text>


  <!-- ========================================= -->
  <!-- RGB GLITCH HEADING                       -->
  <!-- ========================================= -->

  <text
    class="jersey-25-regular"
    x="500"
    y="58"
    text-anchor="middle"
    font-size="43"
    fill="#d88cff"
    filter="url(#rgb-split)"
    opacity="0">

    hey, I'm Nandhini

    <animate
      attributeName="opacity"
      values="0;0;1;0;0"
      keyTimes="0;0.35;0.38;0.42;1"
      dur="4s"
      repeatCount="indefinite"/>

  </text>


  <!-- ========================================= -->
  <!-- EXTRA MAGENTA RGB LAYER                  -->
  <!-- ========================================= -->

  <text
    class="jersey-25-regular"
    x="500"
    y="58"
    text-anchor="middle"
    font-size="43"
    fill="#ff1493"
    opacity="0">

    hey, I'm Nandhini

    <animateTransform
      attributeName="transform"
      type="translate"
      values="
        0 0;
        9 0;
        -5 0;
        4 0;
        0 0"
      dur="4s"
      repeatCount="indefinite"/>

    <animate
      attributeName="opacity"
      values="0;0;0.7;0;0"
      keyTimes="0;0.36;0.38;0.42;1"
      dur="4s"
      repeatCount="indefinite"/>

  </text>


  <!-- ========================================= -->
  <!-- EXTRA CYAN RGB LAYER                    -->
  <!-- ========================================= -->

  <text
    class="jersey-25-regular"
    x="500"
    y="58"
    text-anchor="middle"
    font-size="43"
    fill="#00eaff"
    opacity="0">

    Hey, I'm Nandhini

    <animateTransform
      attributeName="transform"
      type="translate"
      values="
        0 0;
        -9 0;
        5 0;
        -4 0;
        0 0"
      dur="4s"
      repeatCount="indefinite"/>

    <animate
      attributeName="opacity"
      values="0;0;0.7;0;0"
      keyTimes="0;0.36;0.38;0.42;1"
      dur="4s"
      repeatCount="indefinite"/>

  </text>



  


  <!-- ========================================= -->
  <!-- PINK END DOT                            -->
  <!-- ========================================= -->

  <circle
    cx="700"
    cy="159"
    r="4"
    fill="#ff1493"
    filter="url(#pinkGlow)">

    <animate
      attributeName="opacity"
      values="0;1;1;0"
      keyTimes="0;0.15;0.75;1"
      dur="7s"
      repeatCount="indefinite"/>

  </circle>

</svg>
